---
import { Image } from 'astro:assets';
import bg from '../../assets/images/bg.jpg';
import Button from '../ui/Button.astro';
import StatCounter from '../ui/StatCounter.astro';
import { stats } from '../../data/stats';
---

<section class="relative overflow-hidden border-b border-line pt-32 sm:pt-40">
  <Image
    src={bg}
    alt=""
    aria-hidden="true"
    width={1600}
    height={1000}
    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-20"
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-bg via-bg/90 to-bg"></div>

  <div class="relative mx-auto max-w-7xl px-6 pb-20">
    <div class="max-w-4xl">
      <h1 class="font-display text-5xl font-bold leading-[0.92] sm:text-7xl lg:text-8xl">
        <span data-hero-line class="block opacity-0">WHITE HOUSE</span>
        <span data-hero-line class="ml-6 block opacity-0 sm:ml-16">
          <span class="sign-flicker">GAMING.</span>
        </span>
      </h1>
      <p data-hero-line class="mt-6 font-display text-2xl font-bold text-accent opacity-0 sm:ml-16 sm:text-4xl">
        Independent Game Studio
      </p>
      <p data-hero-line class="mt-4 font-display text-sm font-bold uppercase tracking-[0.25em] text-ink-dim opacity-0 sm:ml-16">
        Games &middot; VR &middot; Interactive Development
      </p>
      <p data-hero-line class="mt-8 max-w-xl text-lg leading-relaxed text-ink-dim opacity-0 sm:ml-16">
        Building games, immersive VR experiences, and interactive applications with Unity.
      </p>
      <div data-hero-line class="relative mt-10 flex flex-wrap items-center gap-4 opacity-0 sm:ml-16">
        <Button href="/projects" variant="primary">Explore Projects</Button>
        <Button href="/services" variant="ghost">Work With Me</Button>
      </div>
    </div>
  </div>

  <div class="relative border-t border-line/60 bg-bg-raised/60 backdrop-blur-sm">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-6 py-10 sm:grid-cols-3">
      {stats.map((stat) => <StatCounter {...stat} />)}
    </div>
  </div>
</section>
