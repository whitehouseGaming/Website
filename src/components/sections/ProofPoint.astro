---
import { getCollection } from 'astro:content';
import YouTubeFacade from '../ui/YouTubeFacade.astro';
import Button from '../ui/Button.astro';

const videos = (await getCollection('videos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = videos[0];
---

{
  latest && (
    <section class="relative border-b border-line py-24">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div data-reveal>
          <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">
            From the Devlog
          </p>
          <h2 class="font-display mt-3 text-4xl font-bold leading-[0.95] sm:text-5xl">
            Built in the open.
          </h2>
          <p class="mt-5 max-w-md text-ink-dim">
            Prototypes, playtests, and shipped builds — a running record of what White House
            Gaming is building right now.
          </p>
          <Button href="/videos" variant="ghost" class="mt-8">
            Watch More Devlogs
          </Button>
        </div>
        <div data-reveal>
          <YouTubeFacade youtubeId={latest.data.youtubeId} title={latest.data.title} />
        </div>
      </div>
    </section>
  )
}
