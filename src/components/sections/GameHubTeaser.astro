---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '../ui/Button.astro';
import omgLogo from '../../assets/images/OMGLOGO.webp';

const allGames = (await getCollection('games'))
  .filter((g) => !g.data.placeholder)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="relative border-b border-line py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div
      data-reveal
      data-cursor-hover
      class="group relative flex flex-col items-center gap-6 overflow-hidden rounded-sm border border-line bg-bg-raised p-10 text-center sm:p-16"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-0 shadow-[inset_0_0_60px_theme(colors.accent)] transition-opacity duration-500 group-hover:opacity-30"
      >
      </div>
      <Image
        src={omgLogo}
        alt="One More Game"
        width={128}
        height={128}
        class="relative w-28 rounded-sm border border-line transition-transform duration-500 group-hover:scale-105 sm:w-36"
      />
      <div class="relative">
        <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">One More Game</p>
        <h2 class="font-display mt-3 max-w-lg text-4xl font-bold leading-[0.95] sm:text-5xl">
          One app. 10+ games. Endless replay.
        </h2>
        <p class="mx-auto mt-4 max-w-md text-ink-dim">
          Every hypercasual title we ship lives inside a single free app, with a tournament
          system that pays out real recharge prizes.
        </p>
      </div>
      <Button href="/games" variant="primary" class="relative">Explore GameHub</Button>
    </div>

    <div class="mt-12 flex flex-wrap justify-center gap-6 sm:justify-between">
      {
        allGames.map((game) => (
          <a
            href={`/games/${game.id}`}
            data-cursor-hover
            data-reveal
            class="group flex w-20 flex-col items-center gap-2 text-center sm:w-24"
          >
            <span class="block aspect-square w-20 overflow-hidden rounded-sm border border-line bg-bg-raised-2 transition-colors group-hover:border-accent sm:w-24">
              {game.data.coverImage ? (
                <Image
                  src={game.data.coverImage}
                  alt={game.data.title}
                  width={192}
                  height={192}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
                />
              ) : (
                <span class="flex h-full w-full items-center justify-center font-display text-xl font-bold text-ink-faint">
                  ?
                </span>
              )}
            </span>
            <span class="font-display text-xs font-bold text-ink-dim transition-colors group-hover:text-accent">
              {game.data.title}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
