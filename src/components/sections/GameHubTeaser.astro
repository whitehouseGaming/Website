---
import { getCollection } from 'astro:content';
import GameCard from '../ui/GameCard.astro';
import Button from '../ui/Button.astro';

const allGames = await getCollection('games');
const featured = allGames
  .filter((g) => g.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section class="relative border-b border-line py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div data-reveal>
        <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">OMG GameHub</p>
        <h2 class="font-display mt-3 max-w-lg text-4xl font-bold leading-[0.95] sm:text-5xl">
          One app. 10+ games. Endless replay.
        </h2>
      </div>
      <Button href="/games" variant="ghost" class="shrink-0">View All Games</Button>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((game, i) => (
          <GameCard
            href={`/games/${game.id}`}
            title={game.data.title}
            tagline={game.data.tagline}
            coverImage={game.data.coverImage}
            class={i === 0 ? 'lg:col-span-2' : ''}
          />
        ))
      }
    </div>
  </div>
</section>
