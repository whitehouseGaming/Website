---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  href: string;
  title: string;
  tagline: string;
  status: 'In Development' | 'Launched' | 'Concept';
  date: Date;
  coverImage?: ImageMetadata;
}

const { href, title, tagline, status, date, coverImage } = Astro.props;

const statusStyles: Record<Props['status'], string> = {
  Launched: 'border-accent text-accent',
  'In Development': 'border-accent/50 text-ink',
  Concept: 'border-ink-faint text-ink-faint',
};

const year = date.getFullYear();
---

<div data-timeline-item class="relative pl-10 pb-12 opacity-0 last:pb-0">
  <span class="absolute left-0 top-1 h-3 w-3 -translate-x-1/2 rounded-full bg-accent shadow-[0_0_10px_theme(colors.accent)]"></span>
  <p class="font-display text-xs font-bold uppercase tracking-wide text-accent">{year}</p>

  <a
    href={href}
    data-cursor-hover
    data-tilt
    class="group mt-3 flex flex-col gap-4 rounded-sm border border-line bg-bg-raised p-5 transition-colors hover:border-accent sm:flex-row sm:items-center"
  >
    <div class="relative aspect-video w-full shrink-0 overflow-hidden rounded-sm bg-bg-raised-2 sm:w-56">
      {
        coverImage ? (
          <Image
            src={coverImage}
            alt={title}
            width={448}
            height={252}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-[repeating-linear-gradient(135deg,theme(colors.bg-raised-2),theme(colors.bg-raised-2)_10px,theme(colors.bg)_10px,theme(colors.bg)_11px)]">
            <span class="font-display text-3xl font-bold text-ink-faint/70">{title.charAt(0)}</span>
          </div>
        )
      }
    </div>
    <div class="flex-1">
      <span
        class:list={[
          'font-display inline-block -rotate-2 rounded-full border px-3 py-1 text-[11px] font-bold uppercase tracking-wide',
          statusStyles[status],
        ]}
      >
        {status}
      </span>
      <h3 class="glitch-hover font-display mt-2 text-xl font-bold text-ink" data-text={title}>
        {title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-dim">{tagline}</p>
    </div>
  </a>
</div>
