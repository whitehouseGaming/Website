---
import { site } from '../../data/site';

const year = new Date().getFullYear();

const quickLinks = [
  { label: 'About', href: '/about' },
  { label: 'Freelance', href: '/freelance' },
  { label: 'GameHub', href: '/games' },
  { label: 'Projects', href: '/projects' },
  { label: 'Videos', href: '/videos' },
  { label: 'FAQ', href: '/faq' },
];

const socialLinks = [
  { label: 'LinkedIn', href: site.socials.linkedin },
  { label: 'GitHub', href: site.socials.github },
  { label: 'Facebook', href: site.socials.facebook },
  { label: 'YouTube', href: site.socials.youtube || undefined },
].filter((s) => s.href);
---

<footer class="relative border-t border-line bg-bg-raised">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-bold uppercase tracking-wide text-ink">White House Gaming</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-dim">
        An indie game &amp; XR studio shipping mobile games and building immersive experiences
        for clients worldwide.
      </p>
    </div>

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-dim">Explore</p>
      <ul class="mt-4 space-y-2">
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-dim transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-dim">Contact</p>
      <ul class="mt-4 space-y-2 text-sm text-ink-dim">
        <li>{site.location}</li>
        <li>
          <a href={`mailto:${site.email}`} class="transition-colors hover:text-accent">{site.email}</a>
        </li>
        <li>
          <a href={`tel:${site.phone.replace(/\s+/g, '')}`} class="transition-colors hover:text-accent">
            {site.phone}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-dim">Follow</p>
      <ul class="mt-4 space-y-2">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-ink-dim transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line/60 px-6 py-6 text-center text-xs text-ink-faint">
    &copy; {year} White House Gaming. All rights reserved.
  </div>
</footer>
