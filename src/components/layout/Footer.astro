---
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { services } from '../../data/services';

const year = new Date().getFullYear();

const games = (await getCollection('games'))
  .filter((g) => !g.data.placeholder)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const companyLinks = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const legalLinks = [
  { label: 'Terms & Conditions', href: '/terms' },
  { label: 'Privacy Policy', href: '/privacy' },
];

const socialLinks = [
  { label: 'LinkedIn', initial: 'L', href: site.socials.linkedin },
  { label: 'GitHub', initial: 'G', href: site.socials.github },
  { label: 'Facebook', initial: 'F', href: site.socials.facebook },
  { label: 'YouTube', initial: 'Y', href: site.socials.youtube || undefined },
].filter((s) => s.href);
---

<footer class="relative border-t border-line bg-bg-raised">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-10 px-6 py-16 sm:grid-cols-3 lg:grid-cols-5">
    <div class="col-span-2 sm:col-span-3 lg:col-span-1">
      <p class="font-display text-lg font-bold uppercase tracking-wide text-ink">White House Gaming</p>
      <p class="font-display mt-2 text-sm font-bold text-accent">Independent Game Studio</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-dim">Games &middot; VR &middot; Interactive Development</p>
      <p class="mt-3 text-xs text-ink-faint">{site.location}</p>
      <div class="mt-5 flex gap-2">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="font-display flex h-10 w-10 items-center justify-center rounded-full border border-line text-sm font-bold text-ink-dim transition-colors hover:border-accent hover:text-accent"
            >
              {link.initial}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-dim">Games</p>
      <ul class="mt-4 space-y-2">
        {
          games.map((game) => (
            <li>
              <a href={`/games/${game.id}`} class="text-sm text-ink-dim transition-colors hover:text-accent">
                {game.data.title}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/games" class="text-sm font-bold text-accent">View All &rarr;</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-dim">Services</p>
      <ul class="mt-4 space-y-2">
        {
          services.map((service) => (
            <li>
              <a href="/services" class="text-sm text-ink-dim transition-colors hover:text-accent">
                {service.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-dim">Site</p>
      <ul class="mt-4 space-y-2">
        {
          companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-dim transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-dim">Contact</p>
      <ul class="mt-4 space-y-2 text-sm text-ink-dim">
        <li>
          <a href={`mailto:${site.email}`} class="transition-colors hover:text-accent">{site.email}</a>
        </li>
      </ul>
      <ul class="mt-4 space-y-2 border-t border-line/60 pt-4">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-dim transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line/60 px-6 py-6 text-center text-xs text-ink-faint">
    <p>&copy; {year} White House Gaming. All rights reserved.</p>
  </div>
</footer>
