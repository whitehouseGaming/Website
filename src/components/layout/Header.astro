---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';
import { navLinks } from '../../data/nav';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-bg/80 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="group flex items-center gap-3">
      <Image src={logo} alt="White House Gaming" width={36} height={36} class="rounded-sm" />
      <span class="font-display text-sm font-bold uppercase tracking-[0.15em] text-ink">
        White House Gaming
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'font-display relative text-sm font-bold uppercase tracking-wide transition-colors',
              isActive(link.href) ? 'text-accent' : 'text-ink-dim hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/freelance"
        class="font-display rounded-sm bg-accent px-4 py-2 text-sm font-bold uppercase tracking-wide text-accent-ink transition-transform hover:-translate-y-0.5 hover:shadow-[0_0_20px_theme(colors.accent)]"
      >
        Let's Talk
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-bar block h-0.5 w-6 bg-ink transition-transform"></span>
      <span class="menu-bar block h-0.5 w-6 bg-ink transition-opacity"></span>
      <span class="menu-bar block h-0.5 w-6 bg-ink transition-transform"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-line/60 bg-bg px-6 py-4 lg:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'font-display rounded-sm px-2 py-3 text-base font-bold uppercase tracking-wide',
            isActive(link.href) ? 'text-accent' : 'text-ink-dim',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="/freelance"
      class="font-display mt-2 rounded-sm bg-accent px-4 py-3 text-center text-base font-bold uppercase tracking-wide text-accent-ink"
    >
      Let's Talk
    </a>
  </nav>
</header>

<script>
  function initMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.bound) return;
    toggle.dataset.bound = 'true';

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('flex');
      menu.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.classList.toggle('is-open', isOpen);
    });

    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        toggle.setAttribute('aria-expanded', 'false');
      }),
    );
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>

<style>
  #menu-toggle.is-open .menu-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #menu-toggle.is-open .menu-bar:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.is-open .menu-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
