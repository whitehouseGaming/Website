---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  tagline: string;
  coverImage?: ImageMetadata;
  backHref: string;
  backLabel: string;
}

const { title, tagline, coverImage, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={tagline}>
  <article class="mx-auto max-w-5xl px-6 pb-24 pt-28 sm:pt-32">
    <a
      href={backHref}
      class="font-display inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-ink-dim transition-colors hover:text-accent"
    >
      <span aria-hidden="true">&larr;</span> {backLabel}
    </a>

    <header class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <slot name="badge" />
        <h1 class="font-display mt-3 text-4xl font-bold leading-[0.95] sm:text-6xl">
          {title}
        </h1>
        <p class="mt-4 max-w-xl text-lg text-ink-dim">{tagline}</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <slot name="cta" />
      </div>
    </header>

    {
      coverImage && (
        <div class="relative mt-10 overflow-hidden rounded-sm border border-line">
          <Image
            src={coverImage}
            alt={title}
            width={1200}
            height={675}
            class="aspect-video w-full object-cover"
          />
        </div>
      )
    }

    <div class="prose-invert mt-12 max-w-2xl leading-relaxed text-ink-dim [&_h2]:font-display [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-ink [&_li]:mt-1 [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-5">
      <slot />
    </div>

    <div class="mt-16">
      <slot name="videos" />
    </div>
  </article>
</BaseLayout>
