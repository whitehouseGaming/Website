---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import GameHubTeaser from '../components/sections/GameHubTeaser.astro';
import ToolsTeaser from '../components/sections/ToolsTeaser.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import Ticker from '../components/ui/Ticker.astro';
import { site } from '../data/site';

const tickerItems = [
  'UNITY',
  'BLENDER',
  'VR / AR INTEGRATION',
  'MULTIPLAYER SYSTEMS',
  'PUBLISHING',
  'SHIPPED ON PLAY STORE',
];
---

<BaseLayout
  title="White House Gaming | Independent Game Studio & Unity Developer"
  description={site.tagline}
>
  <Hero />
  <div class="my-2 overflow-hidden">
    <Ticker items={tickerItems} />
  </div>
  <GameHubTeaser />
  <ToolsTeaser />
  <CtaBlock />
</BaseLayout>
