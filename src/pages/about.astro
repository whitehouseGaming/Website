---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionDivider from '../components/layout/SectionDivider.astro';
import TechMarquee from '../components/ui/TechMarquee.astro';
import TimelineItem from '../components/ui/TimelineItem.astro';
import Button from '../components/ui/Button.astro';
import { skills } from '../data/skills';
import { timeline } from '../data/timeline';
import { site } from '../data/site';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/ashu-photo.*',
  { eager: true },
);
const photo = Object.values(photoModules)[0]?.default;
---

<BaseLayout title="About" description="Ashutosh Yadav (Ashu) — Unity/VR/XR developer running White House Gaming, a one-person indie studio.">
  <section class="relative border-b border-line pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-7xl px-6">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">
        About Me
      </p>
      <h1 data-reveal class="font-display mt-4 max-w-3xl text-5xl font-bold leading-[0.95] sm:text-7xl">
        I'm Ashu. <span class="text-accent">I build things.</span>
      </h1>

      <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[240px_1fr] lg:items-start">
        <div data-reveal class="relative mx-auto w-56 -rotate-2 sm:mx-0 lg:w-full">
          <div class="overflow-hidden rounded-sm border border-line bg-bg-raised-2">
            {
              photo ? (
                <Image
                  src={photo}
                  alt={site.founder}
                  width={480}
                  height={600}
                  class="aspect-[4/5] w-full object-cover"
                />
              ) : (
                <div class="flex aspect-[4/5] w-full flex-col items-center justify-center gap-2 border border-dashed border-line p-4 text-center">
                  <span class="font-display text-xs font-bold uppercase tracking-wide text-ink-faint">
                    TODO_PHOTO
                  </span>
                  <span class="text-xs text-ink-faint">Drop a photo at src/assets/images/ashu-photo.jpg</span>
                </div>
              )
            }
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <p data-reveal class="text-lg leading-relaxed text-ink-dim">
            I'm <strong class="text-ink">Ashutosh Yadav (Ashu)</strong>, a Unity/VR/XR
            developer with 4+ years of experience shipping products end to end — prototype,
            playtest, ship, iterate. I run <strong class="text-ink">White House Gaming</strong>,
            a small indie studio — it's just me — where I build and publish
            <strong class="text-ink">OMG GameHub</strong>, alongside contract Unity/VR/XR work
            for clients worldwide.
          </p>
          <p data-reveal class="text-ink-dim">
            From hypercasual mobile hits to surgical VR simulations and multiplayer casino
            builds, my focus stays the same: ship real, playable things — not decks.
          </p>
          <div data-reveal>
            {
              site.resumeUrl ? (
                <Button href={site.resumeUrl} variant="ghost" external class="self-start">
                  Download Resume
                </Button>
              ) : (
                <span class="font-display self-start rounded-sm border border-dashed border-line px-6 py-3 text-sm font-bold uppercase tracking-wide text-ink-faint">
                  TODO_RESUME_LINK
                </span>
              )
            }
          </div>
        </div>
      </div>

      <div class="mt-14 flex flex-wrap gap-3" data-reveal>
        {
          skills.map((skill) => (
            <span class="font-display rounded-full border border-line px-4 py-2 text-xs font-bold uppercase tracking-wide text-ink-dim transition-colors hover:border-accent hover:text-accent">
              {skill}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <SectionDivider />

  <section class="relative bg-bg-raised/40 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 data-reveal class="font-display text-3xl font-bold sm:text-4xl">Career Timeline</h2>

      <div class="relative mt-12 pl-2">
        <div class="absolute left-0 top-1 bottom-0 w-px bg-line" aria-hidden="true"></div>
        <div
          data-timeline-line
          class="absolute left-0 top-1 bottom-0 w-px origin-top scale-y-0 bg-accent shadow-[0_0_8px_theme(colors.accent)]"
          aria-hidden="true"
        >
        </div>
        {timeline.map((entry) => <TimelineItem {...entry} />)}
      </div>
    </div>
  </section>

  <section class="border-t border-line py-4">
    <TechMarquee />
  </section>
</BaseLayout>
