---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionDivider from '../components/layout/SectionDivider.astro';
import Button from '../components/ui/Button.astro';
import { services, provenWork, workflowSteps } from '../data/services';
---

<BaseLayout title="Services" description="Unity game development, VR development, mobile & WebGL, and technical development from White House Gaming.">
  <section class="relative border-b border-line pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-7xl px-6">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">
        Services
      </p>
      <h1 data-reveal class="font-display mt-4 max-w-3xl text-5xl font-bold leading-[0.95] sm:text-7xl">
        Contract work, <span class="text-accent">built by one developer.</span>
      </h1>
      <p data-reveal class="mt-6 max-w-xl text-lg text-ink-dim">
        White House Gaming takes on selected freelance and client development work — Unity
        games, VR applications, mobile and WebGL builds, and interactive applications.
      </p>

      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-sm border border-line bg-line lg:grid-cols-2">
        {
          services.map((service, i) => (
            <div
              data-reveal
              class:list={[
                'bg-bg-raised p-7 transition-colors hover:bg-bg-raised-2',
                i === services.length - 1 && services.length % 2 !== 0 ? 'lg:col-span-2' : '',
              ]}
            >
              <p class="font-display text-xs font-bold text-ink-faint">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="font-display mt-3 text-xl font-bold text-ink">{service.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-dim">{service.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {service.items.map((item) => (
                  <li class="rounded-full border border-line px-3 py-1 text-xs text-ink-dim">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <SectionDivider />

  <section class="relative bg-bg-raised/40 py-20">
    <div class="mx-auto max-w-7xl px-6">
      <h2 data-reveal class="font-display text-3xl font-bold sm:text-4xl">Proven Work</h2>
      <p data-reveal class="mt-3 max-w-xl text-ink-dim">
        Described generically to respect client confidentiality — the work itself speaks for
        the range.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          provenWork.map((item) => (
            <div data-reveal class="rounded-sm border border-line p-6">
              <h3 class="font-display text-lg font-bold text-accent">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-dim">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative py-20">
    <div class="mx-auto max-w-7xl px-6">
      <h2 data-reveal class="font-display text-3xl font-bold sm:text-4xl">How We Work</h2>
      <div class="mt-10 grid grid-cols-1 gap-0 sm:grid-cols-4">
        {
          workflowSteps.map((step, i) => (
            <div data-reveal class="relative border-l border-line py-4 pl-6 sm:border-l-0 sm:border-t sm:py-6 sm:pl-0 sm:pt-6">
              <p class="font-display text-3xl font-bold text-accent">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="font-display mt-2 text-base font-bold text-ink">{step.title}</h3>
              <p class="mt-1 text-sm text-ink-dim">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-20">
    <div class="pointer-events-none absolute inset-0 diagonal-divider bg-bg-raised/40"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-reveal>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Have a project in mind?</h2>
      <p class="mx-auto mt-4 max-w-lg text-ink-dim">
        White House Gaming is available for selected freelance and client development projects.
      </p>
      <Button href="/contact" variant="primary" class="mt-8">Start a Project</Button>
    </div>
  </section>
</BaseLayout>
