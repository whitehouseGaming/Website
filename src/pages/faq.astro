---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faq';
---

<BaseLayout title="FAQ" description="Answers to common questions about White House Gaming, GameHub, and working with the studio.">
  <section class="relative py-32 sm:py-40">
    <div class="mx-auto max-w-3xl px-6">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">FAQ</p>
      <h1 data-reveal class="font-display mt-4 text-5xl font-bold leading-[0.95] sm:text-6xl">
        Common Questions
      </h1>

      <div class="mt-14 divide-y divide-line border-y border-line">
        {
          faqs.map((faq) => (
            <details data-reveal class="group py-6">
              <summary class="font-display flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold text-ink">
                {faq.question}
                <span class="shrink-0 text-accent transition-transform group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-2xl text-ink-dim">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
