---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import Button from '../../components/ui/Button.astro';
import YouTubeFacade from '../../components/ui/YouTubeFacade.astro';
import { site } from '../../data/site';
import omgLogo from '../../assets/images/OMGLOGO.webp';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await render(game);

const relatedVideos = (await getCollection('videos')).filter(
  (v) => v.data.relatedGame?.id === game.id,
);
---

<DetailLayout
  title={game.data.title}
  tagline={game.data.tagline}
  coverImage={game.data.coverImage}
  backHref="/games"
  backLabel="All Games"
>
  <span slot="badge" class="inline-flex -rotate-2 items-center gap-2 rounded-full border border-accent/60 py-1 pl-1 pr-3 text-xs font-bold uppercase tracking-wide text-accent">
    <Image src={omgLogo} alt="" width={20} height={20} class="rounded-full" />
    <span class="font-display">OMG GameHub</span>
  </span>

  <Fragment slot="cta">
    {
      !game.data.placeholder && (
        <Button href={site.gameHubPlayStoreUrl} variant="primary" external>
          Play in OMG GameHub
        </Button>
      )
    }
  </Fragment>

  {
    !game.data.placeholder && (
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-sm border border-line bg-line sm:grid-cols-4">
        {[
          ['Genre', game.data.genre],
          ['Platform', game.data.platform],
          ['Engine', game.data.engine],
          ['Status', 'Live in GameHub'],
        ].map(([label, value]) => (
          <div class="bg-bg-raised p-4">
            <p class="font-display text-[11px] font-bold uppercase tracking-wide text-ink-faint">{label}</p>
            <p class="font-display mt-1 text-sm font-bold text-ink">{value}</p>
          </div>
        ))}
      </div>
    )
  }

  <Content />

  <Fragment slot="videos">
    {
      relatedVideos.length > 0 && (
        <div>
          <h2 class="font-display text-2xl font-bold text-ink">Gameplay</h2>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {relatedVideos.map((video) => (
              <YouTubeFacade youtubeId={video.data.youtubeId} title={video.data.title} />
            ))}
          </div>
        </div>
      )
    }
  </Fragment>
</DetailLayout>
