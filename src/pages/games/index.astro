---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/ui/GameCard.astro';
import Button from '../../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);

const bentoClass = (i: number) => {
  const pattern = ['lg:col-span-2', '', '', '', 'lg:col-span-2', ''];
  return pattern[i % pattern.length];
};
---

<BaseLayout title="GameHub" description="OMG GameHub — one app, 10+ hypercasual games, and a tournament system with real prizes.">
  <section class="relative border-b border-line pb-16 pt-32 sm:pt-40">
    <div class="mx-auto max-w-7xl px-6">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">OMG GameHub</p>
      <h1 data-reveal class="font-display mt-4 max-w-3xl text-5xl font-bold leading-[0.95] sm:text-7xl">
        One app. Every game. <span class="text-accent">Real prizes.</span>
      </h1>
      <p data-reveal class="mt-6 max-w-2xl text-lg text-ink-dim">
        GameHub bundles 10+ hypercasual games into a single free app, with a built-in
        tournament system where top players win mobile recharge prizes. Below is the full
        lineup — each title has its own page with details and a direct Play Store link.
      </p>
      <div data-reveal class="mt-8">
        {
          site.gameHubPlayStoreUrl ? (
            <Button href={site.gameHubPlayStoreUrl} variant="primary" external>
              Get GameHub on Play Store
            </Button>
          ) : (
            <span class="font-display inline-block rounded-sm border border-dashed border-line px-6 py-3 text-sm font-bold uppercase tracking-wide text-ink-faint">
              TODO_GAMEHUB_PLAYSTORE_LINK
            </span>
          )
        }
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          games.map((game, i) => (
            <GameCard
              href={`/games/${game.id}`}
              title={game.data.title}
              tagline={game.data.tagline}
              coverImage={game.data.coverImage}
              isTodo={!game.data.playStoreUrl}
              class={bentoClass(i)}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
