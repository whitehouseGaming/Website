---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';

const roles = [
  'Unity Developers',
  '3D Artists',
  'VR / XR Enthusiasts',
  'Marketing & Growth Collaborators',
];

const perks = [
  'Real, shipped-product experience — not a portfolio-filler project',
  'Public credit on released titles',
  'Revenue share / stipend — TODO_COMPENSATION_MODEL: finalize exact terms per role',
];
---

<BaseLayout title="Join Us" description="Join White House Gaming — a small, fast-moving indie studio.">
  <section class="relative border-b border-line pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">
        Join The Studio
      </p>
      <h1 data-reveal class="font-display mt-4 text-5xl font-bold leading-[0.95] sm:text-7xl">
        Build with a <span class="text-accent">small, fast team.</span>
      </h1>
      <p data-reveal class="mx-auto mt-6 max-w-xl text-lg text-ink-dim">
        White House Gaming is a small, fast-moving indie team — every collaborator ships real
        work that real players touch.
      </p>
      <div data-reveal class="mt-10">
        <Button href={site.joinUsFormUrl} variant="primary" external>Apply via Google Form</Button>
      </div>
    </div>
  </section>

  <section class="relative border-b border-line py-20">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-12 px-6 sm:grid-cols-2">
      <div data-reveal>
        <h2 class="font-display text-2xl font-bold">Who We're Looking For</h2>
        <ul class="mt-5 space-y-3">
          {
            roles.map((role) => (
              <li class="flex items-center gap-3 text-ink-dim">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                {role}
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal>
        <h2 class="font-display text-2xl font-bold">What You Get</h2>
        <ul class="mt-5 space-y-3">
          {
            perks.map((perk) => (
              <li class="flex items-start gap-3 text-ink-dim">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                <span>{perk}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-3xl px-6 text-center" data-reveal>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Fill the form, we'll take it from there.</h2>
    </div>
  </section>
</BaseLayout>
