---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeFacade from '../../components/ui/YouTubeFacade.astro';
import { getCollection } from 'astro:content';

const videos = (await getCollection('videos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const games = await getCollection('games');
const projects = await getCollection('projects');

const gameTitle = (id: string) => games.find((g) => g.id === id)?.data.title;
const projectTitle = (id: string) => projects.find((p) => p.id === id)?.data.title;

const filters = [
  { key: 'all', label: 'All' },
  ...games
    .filter((g) => videos.some((v) => v.data.relatedGame?.id === g.id))
    .map((g) => ({ key: g.id, label: g.data.title })),
  ...projects
    .filter((p) => videos.some((v) => v.data.relatedProject?.id === p.id))
    .map((p) => ({ key: p.id, label: p.data.title })),
];
---

<BaseLayout title="Videos" description="Devlogs and gameplay footage from White House Gaming — filterable by game or project.">
  <section class="relative border-b border-line pb-10 pt-32 sm:pt-40">
    <div class="mx-auto max-w-7xl px-6">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">Devlog &amp; Gameplay</p>
      <h1 data-reveal class="font-display mt-4 max-w-3xl text-5xl font-bold leading-[0.95] sm:text-7xl">
        Watch it get built.
      </h1>

      <div data-reveal class="mt-10 flex flex-wrap gap-2">
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-video-filter={f.key}
              class:list={[
                'font-display rounded-full border border-line px-4 py-2 text-xs font-bold uppercase tracking-wide text-ink-dim transition-colors hover:border-accent hover:text-accent',
                i === 0 ? 'is-active' : '',
              ]}
            >
              {f.label}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6">
      {
        videos.length === 0 ? (
          <p class="text-ink-dim">TODO_VIDEO_DATA — no videos added yet.</p>
        ) : (
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {videos.map((video) => {
              const refs = [video.data.relatedGame?.id, video.data.relatedProject?.id]
                .filter(Boolean)
                .join(',');
              const relatedLabel =
                (video.data.relatedGame && gameTitle(video.data.relatedGame.id)) ||
                (video.data.relatedProject && projectTitle(video.data.relatedProject.id));
              return (
                <div data-video-card data-video-refs={refs} data-reveal>
                  <YouTubeFacade youtubeId={video.data.youtubeId} title={video.data.title} />
                  <p class="font-display mt-3 text-sm font-bold text-ink">{video.data.title}</p>
                  {relatedLabel && <p class="mt-1 text-xs text-ink-faint">{relatedLabel}</p>}
                </div>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <script>
    import '../../scripts/video-filter';
  </script>
</BaseLayout>
