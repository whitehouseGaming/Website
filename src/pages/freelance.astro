---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionDivider from '../components/layout/SectionDivider.astro';
import Button from '../components/ui/Button.astro';
import { services, provenWork, workflowSteps } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout title="Freelance" description="Game development, AR/VR, 3D, and multiplayer backend work from White House Gaming.">
  <section class="relative border-b border-line pb-20 pt-32 sm:pt-40">
    <div class="mx-auto max-w-7xl px-6">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">
        What We Do
      </p>
      <h1 data-reveal class="font-display mt-4 max-w-3xl text-5xl font-bold leading-[0.95] sm:text-7xl">
        Contract work, <span class="text-accent">shipped fast.</span>
      </h1>
      <p data-reveal class="mt-6 max-w-xl text-lg text-ink-dim">
        White House Gaming takes on freelance and contract builds across game development,
        AR/VR, 3D, and app development — for studios, startups, and direct clients.
      </p>

      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-sm border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, i) => (
            <div
              data-reveal
              class:list={[
                'bg-bg-raised p-7 transition-colors hover:bg-bg-raised-2',
                i === 0 ? 'lg:col-span-2' : '',
              ]}
            >
              <p class="font-display text-xs font-bold text-ink-faint">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="font-display mt-3 text-xl font-bold text-ink">{service.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-dim">{service.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <SectionDivider />

  <section class="relative bg-bg-raised/40 py-20">
    <div class="mx-auto max-w-7xl px-6">
      <h2 data-reveal class="font-display text-3xl font-bold sm:text-4xl">Proven Work</h2>
      <p data-reveal class="mt-3 max-w-xl text-ink-dim">
        Described generically to respect client confidentiality — the work itself speaks for
        the range.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          provenWork.map((item) => (
            <div data-reveal class="rounded-sm border border-line p-6">
              <h3 class="font-display text-lg font-bold text-accent">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-dim">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative py-20">
    <div class="mx-auto max-w-7xl px-6">
      <h2 data-reveal class="font-display text-3xl font-bold sm:text-4xl">How We Work</h2>
      <div class="mt-10 grid grid-cols-1 gap-0 sm:grid-cols-4">
        {
          workflowSteps.map((step, i) => (
            <div data-reveal class="relative border-l border-line py-4 pl-6 sm:border-l-0 sm:border-t sm:py-6 sm:pl-0 sm:pt-6">
              <p class="font-display text-3xl font-bold text-accent">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="font-display mt-2 text-base font-bold text-ink">{step.title}</h3>
              <p class="mt-1 text-sm text-ink-dim">{step.description}</p>
            </div>
          ))
        }
      </div>

    </div>
  </section>

  <SectionDivider flip />

  <section class="relative bg-bg-raised/40 py-20">
    <div class="mx-auto max-w-3xl px-6">
      <p data-reveal class="font-display text-sm font-bold uppercase tracking-[0.2em] text-accent">
        Get In Touch
      </p>
      <h2 data-reveal class="font-display mt-3 text-3xl font-bold sm:text-4xl">
        Have a project in mind? Let's talk.
      </h2>
      <p data-reveal class="mt-4 max-w-xl text-ink-dim">
        Open to contract work and select full-time roles — Unity, VR/XR, multiplayer backends.
      </p>

      <div data-reveal class="mt-8 flex flex-wrap gap-4">
        <a
          href={`mailto:${site.email}`}
          class="font-display inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3 text-sm font-bold uppercase tracking-wide text-accent-ink transition-transform hover:-translate-y-0.5"
        >
          Email Us
        </a>
        <a
          href={site.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display inline-flex items-center gap-2 rounded-sm border border-line px-6 py-3 text-sm font-bold uppercase tracking-wide text-ink transition-colors hover:border-accent hover:text-accent"
        >
          LinkedIn
        </a>
      </div>

      <div data-reveal class="mt-6 text-sm text-ink-dim">
        <span>{site.email}</span> &middot; <span>{site.phone}</span>
      </div>

      <div data-reveal class="mt-10 overflow-hidden rounded-sm border border-line bg-bg-raised p-2">
        <iframe
          src={site.contactFormEmbedUrl}
          width="100%"
          height="760"
          loading="lazy"
          title="Contact form"
          class="bg-transparent"
        >
          Loading…
        </iframe>
      </div>
    </div>
  </section>
</BaseLayout>
